{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
  	"type": "raw",
    "source": "~/Code/Config/fastfetch/framework.sixel",
    "padding": {
        "right": 32
    }


  },
  "display": {
    "separator": " :: "
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌─────────── \u001B[1m    硬件信息    \u001B[0m ───────────┐"
    },
    {
        	"type": "custom",
        	"format": "    :: Framework 13 AMD 笔记本"
    },
    {
      "type": "cpu",
      "format": "{name} ({cores-physical}C/{cores-logical}T)",
      "key": "   "
    },
    {
      "type": "gpu",
      "key": "  󰨇 ",
      "format": "{name}",

    },
    {
      "type": "memory",
      "key": "   "
    },
    {
      "type": "disk",
      "key": "   ",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
	   	"type": "bios",
	   	"key": "   "
    },
    {
       	"type": "monitor",
       	"key": "   ",
       	"format": "{name} ({width}x{height})",
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": "├─────────── \u001B[1m    软件信息    \u001B[0m ───────────┤"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "os",
      "key": "   "
    },
    {
      "type": "kernel",
      "key": "   "
    },
    {
          "type": "de",
          "key": "   "
    },
    {
          "type": "initsystem",
          "key": "   "
    },
	{
		"type": "datetime",
		"key": "   "
	},
    {
      "type": "shell",
      "key": "   "
    },
    {
      "type": "packages",
      "key": "   "
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────┘"
    }
  ]
}

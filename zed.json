{
  "cli_default_open_behavior": "existing_window",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^find\\s+/usr/lib(\\s|$)"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^find\\s+/usr(\\s|$)"
            }
          ]
        },
        "fetch": {
          "default": "allow"
        }
      }
    },
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": true
    },
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "gemini-3.1-pro-preview",
        "enable_thinking": false
      },
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-4-6",
        "enable_thinking": false,
        "effort": "low"
      }
    ],
    "model_parameters": []
  },
  "centered_layout": {},
  "terminal": {},
  "middle_click_paste": false,
  "zoomed_padding": true,
  "toolbar": {
    "quick_actions": true,
    "breadcrumbs": false
  },
  "gutter": {
    "line_numbers": true,
    "runnables": true,
    "breakpoints": false,
    "folds": false
  },
  "inline_code_actions": false,
  "scrollbar": {
    "diagnostics": "all",
    "axes": {
      "horizontal": false,
      "vertical": true
    }
  },
  "minimap": {
    "thumb": "always"
  },
  "git": {
    "branch_picker": {
      "show_author_name": false
    },
    "blame": {
      "show_avatar": false
    },
    "inline_blame": {
      "enabled": false
    },
    "git_gutter": "hide"
  },
  "prettier": {
    "allowed": false
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "search": {},
  "diagnostics": {},
  "project_panel": {
    "folder_icons": true,
    "git_status": true,
    "hide_gitignore": false,
    "dock": "left"
  },
  "active_pane_modifiers": {
    "inactive_opacity": 1.0
  },
  "tabs": {
    "show_close_button": "hover",
    "git_status": false,
    "file_icons": true,
    "close_position": "right"
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_user_menu": true,
    "show_branch_name": false,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": true,
    "show_menus": false
  },
  "buffer_font_family": "FiraCode Nerd Font",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "auto_update": false,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard"
  },
  "languages": {
    "LaTeX": {
      "soft_wrap": "editor_width"
    },
    "Python": {
      "show_completion_documentation": true,
      "format_on_save": "on",
      "inlay_hints": {
        "show_other_hints": false,
        "show_parameter_hints": false,
        "show_type_hints": false,
        "show_value_hints": false,
        "enabled": false
      },
      "language_servers": [
        "ty",
        "!basedpyright"
      ],
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    }
  }
}
